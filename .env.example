# Reverse Proxy Ports
# Use 80 and 443 for production / exam demonstration (stop host nginx if running)
# Or use 8080 and 8443 if host ports 80/443 are already in use
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# AI Service Configuration
AI_PROVIDER=groq
AI_API_KEY=your_api_key_here
AI_MODEL=openai/gpt-oss-120b
AI_OFFLINE_MODE=false
AI_TIMEOUT_SECONDS=10.0

# Chat Service Configuration
CHAT_DB_PATH=/app/data/chat.db
